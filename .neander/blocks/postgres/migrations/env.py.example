from alembic import context
from sqlalchemy import text
from server.database import Base, get_engine
from server import models  # Register mapped tables for autogenerate.

if context.is_offline_mode():
    raise RuntimeError("Use an explicit online migration with the database history")
with get_engine().begin() as connection:
    if not connection.scalar(text("SELECT pg_try_advisory_xact_lock(hashtext('neander_schema_migrations'))")):
        raise RuntimeError("Another schema migration is running")
    connection.execute(text("SET LOCAL statement_timeout = '120s'"))
    context.configure(connection=connection, target_metadata=Base.metadata)
    context.run_migrations()
