from functools import lru_cache
import os

from dotenv import load_dotenv
from sqlalchemy import create_engine
from sqlalchemy.engine import make_url
from sqlalchemy.orm import DeclarativeBase, Session

load_dotenv(".env.local", override=False)


class Base(DeclarativeBase):
    pass


@lru_cache
def get_engine():
    url = make_url(os.environ["DATABASE_URL"]).set(drivername="postgresql+psycopg")
    return create_engine(url, pool_pre_ping=True, pool_size=5, max_overflow=0, connect_args={"connect_timeout": 10})


def session():
    with Session(get_engine()) as database:
        yield database
