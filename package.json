{
  "name": "neander-vite-fastapi-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "uv run uvicorn app:app --reload --host 127.0.0.1 --port 8000",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "vite": "8.2.2",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7"
  }
}
